# Kopieren nach .deploy.env und ausfüllen. KEIN Passwort hier eintragen –
# das fragt sftp beim Upload im Terminal ab (oder SSH-Schlüssel beim Hoster hinterlegen).

# SFTP-Server laut Hoster-Panel, z. B. sftp.meinhoster.at
SFTP_HOST=
# Meist 22, manche Hoster nutzen einen anderen Port
SFTP_PORT=22
# SFTP-/FTP-Benutzername
SFTP_USER=
# Webroot der Domain, z. B. /html, /httpdocs, /public_html oder /www/alpenexpress.at
SFTP_PATH=
