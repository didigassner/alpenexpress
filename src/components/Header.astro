---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo.png';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === u('/') ? path === href : path.startsWith(href));
---

<header class="header">
  <div class="wrap header__inner">
    <a href={u('/')} class="header__logo" aria-label={`${site.name} – zur Startseite`}>
      <Image src={logo} alt="" width={200} loading="eager" />
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation">
      <Icon name="menu" class="icon-open" />
      <Icon name="close" class="icon-close" />
      <span class="visually-hidden">Menü</span>
    </button>

    <nav id="hauptnavigation" class="header__nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn header__cta" href={u('/kontakt/')}>Anfragen</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 244 238 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }

  .header__logo img {
    width: clamp(150px, 30vw, 200px);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav ul a {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--text);
    font-weight: 550;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav ul a:hover {
    background: rgb(0 0 0 / 0.05);
  }

  .header__nav ul a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }

  .header__cta {
    min-height: 42px;
    padding-block: 0.5em;
  }

  .header__toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .header__toggle :global(svg) {
    width: 28px;
    height: 28px;
    margin: auto;
  }

  .header__toggle :global(.icon-close),
  :global(.nav-open) .header__toggle :global(.icon-open) {
    display: none;
  }

  :global(.nav-open) .header__toggle :global(.icon-close) {
    display: block;
  }

  @media (max-width: 1100px) {
    .header__toggle {
      display: block;
    }

    .header__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 24px rgb(0 0 0 / 0.08);
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
    }

    :global(.nav-open) .header__nav {
      display: flex;
    }

    .header__nav ul {
      flex-direction: column;
    }

    .header__nav ul a {
      padding: 12px 8px;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }

    .header__nav ul a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-left: 14px;
    }
  }
</style>
