---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import didie from '../assets/img/didie-martin.jpg';

const traits = ['Aktuell', 'Top-Repertoire', 'Vielseitig', 'Professionell', 'Zuverlässig', 'Sympathisch', 'Humorvoll', 'Empfehlenswert'];

const tv = ['Rudi Carrell Show', 'Die Goldene Eins', 'Tritsch Tratsch (ORF)', 'Wunschbox', '3nach9', 'Aktuelle Schaubude', 'Musik für Sie', 'Traumshow', 'Aber bitte mit Schlager', 'Barbara Karlich Show'];

const stations = ['ORF', 'TW1', '3sat', 'Sat.1', 'SF 2', 'RTL', 'WDR'];

const events = [
  'Bümplitzer Chilbi, Bern', 'Chilbi Eschen (FL)', 'Stadtfest Biberach', 'Open Air Klostertal', 'Zuger Messe', 'Dornbirner Messe', 'Musikmesse Innsbruck', 'Kulturhaus Dornbirn', 'Bremer Stadthalle', 'Kilbi Lustenau', 'Kilbi Damüls', 'Burghotel Oberlech', 'Kuhstall Lenzerheide', 'Schützenhaus Winterthur', 'Enzianhütte Oberstaufen', 'Dampfbierbrauerei Oberstdorf', 'Golfclub Oberstaufen', 'Funkenzunft Klösterle', 'Funkenzunft Hohenems', 'Gemeinde Silbertal', 'Gemeinde Vandans', 'Schwimmbad Braz', 'FC Rebstein', 'FC Solothurn', 'FC Fussach', 'FC Eschen', 'SOB-Diplomball Rankweil',
];

const clients = ['Siemens', 'Mercedes', 'Nestlé', 'Allianz', 'TUI', 'Ford', 'Media Markt', 'McDonald’s', 'Johnson & Johnson', 'Edeka', 'Eduscho', 'Suchard', 'Granini', 'Bausparkasse Schwäbisch Hall', 'Nord/LB', 'WestLB', 'ISPO', 'Kärnten Tourismus', 'Flughafen Kärnten', 'Fulda Reifen', 'Banner Batterien', 'ALU Tec', 'Nachbaur Reisen', 'KSV Götzis', 'Mercedes Schneider Dornbirn'];

// Vorbereitete E-Mails (Texte so von Didi vorgegeben), reine mailto-Links ohne Script
const mailto = (subject: string, body: string) =>
  `mailto:office@alpenexpress.at?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const cdMail = mailto(
  'CD-Anfrage – Didi Martin / Dietmar Gassner',
  'Hallo Didi,\n\nich interessiere mich für folgende CD: [Irgendwann / Ich denk an dich]\n\nBitte teile mir die Bestell- und Versandmöglichkeiten mit.\n\nGewünschte CD:\nStückzahl:\nLieferland:\n\nViele Grüsse',
);

const royBlackMail = mailto(
  'Buchungsanfrage – Roy-Black-Hommage',
  'Hallo Didi,\n\nich interessiere mich für deine Roy-Black-Hommage. Das ist eine unverbindliche Anfrage für die Roy-Black-Hommage, separat von der Partyband.\n\nVeranstaltungsdatum:\nVeranstaltungsort:\nVeranstaltungsart:\n\nViele Grüsse',
);
---

<Base
  title="Über uns"
  description="Wir sind die Alpenexpress Partyband – Musik, die Generationen verbindet! Live-Musik für Hochzeiten, Firmenfeiern, Zeltfeste, Oktoberfeste und Après-Ski."
>
  <PageHero eyebrow="Über uns" title="Wir sind die Alpenexpress Partyband – Musik, die Generationen verbindet!" />

  <section class="section">
    <div class="wrap prose intro">
      <p>
        Mit Leidenschaft, Vielseitigkeit und langjähriger Bühnenerfahrung sorgen wir für beste Unterhaltung und ausgelassene Stimmung. Ob Hochzeiten, Firmenfeiern, Zeltfeste, Oktoberfeste oder Après-Ski – wir begeistern Jung und Alt mit abwechslungsreicher Live-Musik. Je nach Veranstaltung sind wir als Solist, Duo oder Trio buchbar. Viele Veranstalter buchen uns regelmässig wieder – darauf sind wir besonders stolz.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--2 align-start">
      <div>
        <span class="eyebrow">Didie Martin</span>
        <h2>Musik für Jung und Alt</h2>
        <p>
          Die Alpenexpress Partyband spielt im Duo mit Gitarrist oder im Trio mit Band die beliebtesten Rockklassiker, aber auch die grossen Partyknaller, Austropop, bekannte Schweizer Mundartlieder, Hits der 50er- bis 90er-Jahre, aktuelle Charts, Oldies, Evergreens, Schlager, Oberkrainer, Country, Tanzmusik und vieles mehr.
        </p>
        <p>
          Immer wieder ein Genuss: Wenn Didie auf Wunsch des Publikums Songs von Elvis Presley singt – so, wie er es schon in zahlreichen Fernsehsendungen getan hat.
        </p>
        <ul class="tags">
          {traits.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <Image src={didie} alt="Porträt von Didie Martin mit Schirmmütze" class="photo" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 560px" />
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap grid grid--2 align-start">
      <div>
        <span class="eyebrow">Elvis-Show</span>
        <h2>Einer der bekanntesten Elvis-Interpreten</h2>
        <p>
          Didie gilt nach wie vor als einer der besten und bekanntesten Elvis-Presley-Interpreten im deutschsprachigen Raum. Bekannt wurde er durch die legendäre Rudi Carrell Show – vergleichbar mit heutigen Castingshows. Bis heute wird die Elvis-Show für kleine und grosse Anlässe eigens gebucht.
        </p>
      </div>
      <div>
        <span class="eyebrow">Funk & Fernsehen</span>
        <h2>TV-Auftritte</h2>
        <ul class="tags">
          {tv.map((t) => <li>{t}</li>)}
        </ul>
        <p class="stations">Gesendet u. a. auf {stations.join(', ')}.</p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="musiker">
    <div class="wrap prose musiker">
      <span class="eyebrow">Die Band</span>
      <h2 id="musiker">Unsere Musiker</h2>

      <article>
        <h3>Alexander (Alex) – Gitarre und Gesang</h3>
        <p>Geboren am 13. April in Leoben in der Steiermark, lebt Alex heute in Feldkirch. Als jüngstes Mitglied der Alpenexpress Partyband bereichert er die Formation mit seiner langjährigen Bühnenerfahrung, musikalischen Vielseitigkeit und Leidenschaft.</p>
        <p>Ob E-Gitarre, Akustikgitarre oder Gesang – seine musikalischen Stärken reichen von Austropop, Rock und Country über Pop bis hin zu zeitgemäßen Partysongs.</p>
        <p>Mit seinem Gespür für das Publikum und die richtige Musik im richtigen Moment trägt er zu stimmungsvollen und unvergesslichen Veranstaltungen bei.</p>
      </article>

      <article>
        <h3>Silvio (Silli) – Gesang, Schlagzeug und Bass</h3>
        <p>Der gebürtige Salzburger ist ein Vollblutmusiker mit langjähriger Musiker- und Bühnenerfahrung. Bereits in jungen Jahren entdeckte er seine Leidenschaft für die Musik. Neben seinem Gesang beherrscht er Schlagzeug, Bass und Keyboard. Seine besonderen musikalischen Stärken liegen im Schlager, in der volkstümlichen Musik sowie in der Tanz- und Unterhaltungsmusik. Mit seiner Erfahrung und Vielseitigkeit bereichert er die Alpenexpress Partyband.</p>
        <p>Eine besondere Gemeinsamkeit mit Didi: Beide feiern am 28. Dezember Geburtstag.</p>
      </article>

      <article>
        <h3>Didi – Gesang, Keyboard, Bandleitung und Management</h3>
        <p>Der gebürtige Götzner blickt auf eine vielseitige musikalische Karriere mit langjähriger Bühnen- und Fernseherfahrung zurück. Bereits in jungen Jahren entdeckte er seine Leidenschaft für die Musik.</p>
        <p>Sein Auftritt als Roy-Black-Interpret in der legendären Rudi-Carrell-Show verschaffte ihm überregionale Aufmerksamkeit im deutschsprachigen Musikgeschäft. Es folgten Auftritte in verschiedenen TV-Sendungen, zahlreiche Presseberichte bis hin zu Titelgeschichten in bekannten Zeitschriften der Regenbogenpresse sowie verschiedene Musikproduktionen. Auch als Elvis-Imitator begeistert er mit seiner musikalischen Vielseitigkeit. Die Zusammenarbeit mit dem Musikproduzenten Günter Behrle, den Persönlichkeiten der Schlagerbranche Kurt Hertha und Rolf Arland sowie seinem damaligen Manager Hans R. Bayerlein prägte seinen musikalischen Werdegang.</p>
        <p>Unter seinem bürgerlichen Namen Dietmar Gassner veröffentlichte er bei Titan die Maxi-CD „Irgendwann“. Unter dem Künstlernamen Didi Martin erschien bei Tyrolis sein Album „Ich denk an dich“ – eine musikalische Hommage an Roy Black, initiiert von Günter Behrle und Tyrolis-Chef Christian Rasinger, gemeinsam mit Didi, der dabei selbst als Produzent mitwirkte. Auch auf einer Gemeinschaftsproduktion von „Meine Melodie“ war er als Interpret vertreten.</p>
        <p>Sein vielseitiges Repertoire reicht von Schlager, Country und Pop bis hin zu Austropop. Sein musikalisches Herz schlägt jedoch besonders für Rock ’n’ Roll und mitreißende Partymusik. Als Kopf und musikalische treibende Kraft der Alpenexpress Partyband ist er für die musikalische Ausrichtung, Organisation und das Management verantwortlich.</p>
        <p>Weitere Einblicke in seinen musikalischen Werdegang bieten die Presseberichte, Fernsehauftritte und CD-Produktionen.</p>
        <p>Auch heute ist Didi auf Anfrage mit seiner Roy-Black-Hommage live zu erleben. Dieses separat buchbare Programm umfasst nach Vereinbarung zwei musikalische Auftritte von jeweils rund 20 Minuten.</p>
        <p class="btn-row">
          <a class="btn mail-btn" href={royBlackMail}>Roy-Black-Hommage anfragen</a>
        </p>
        <p class="hint">Der Button öffnet eine vorbereitete E-Mail an office@alpenexpress.at. Die Anfrage ist unverbindlich und separat von der Partyband.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="cds">
    <div class="wrap prose musiker">
      <span class="eyebrow">CD-Produktionen</span>
      <h2 id="cds">Didis CDs</h2>

      <article>
        <h3>„Ich denk an dich“ – Didi Martin</h3>
        <p>Album, erschienen bei Tyrolis – eine musikalische Hommage an Roy Black.</p>
        <p>Auch im Musikhandel in Österreich, Deutschland und der Schweiz erhältlich. Direkt hier bestellen – 12 Euro, auf Wunsch persönlich signiert, zuzüglich Versand. Versand Österreich 4 Euro, europäisches Ausland 8 Euro; Schweiz/Liechtenstein gegebenenfalls Zollformalitäten.</p>
      </article>

      <article>
        <h3>„Irgendwann“ – Dietmar Gassner</h3>
        <p>Maxi-CD, erschienen bei Titan. Preis und Versand auf Anfrage.</p>
      </article>

      <p class="btn-row">
        <a class="btn mail-btn" href={cdMail}>CD direkt hier bestellen</a>
      </p>
      <p class="hint">Der Button öffnet eine vorbereitete E-Mail an office@alpenexpress.at. Bitte gewünschte CD, Stückzahl und Lieferland angeben.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Referenzen</span>
      <h2>Öffentliche Auftritte (Auswahl)</h2>
      <ul class="tags">
        {events.map((e) => <li>{e}</li>)}
      </ul>

      <h2 class="spaced">Kunden (Auswahl)</h2>
      <p class="lead">Zu unseren langjährigen Kunden zählen regionale, nationale und internationale Veranstalter und Unternehmen aus ganz Europa.</p>
      <ul class="tags">
        {clients.map((c) => <li>{c}</li>)}
      </ul>

      <h2 class="spaced">Private Feiern</h2>
      <p class="lead">Hochzeiten, Geburtstage, Jubiläen und Familienfeste – einen Eindruck davon findest du im <a href={u('/rueckblick/')}>Rückblick</a>.</p>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: 0;
  }

  .align-start {
    align-items: start;
  }

  .tags {
    margin-top: 20px;
  }

  .stations {
    margin-top: 20px;
    color: #bdb8ad;
  }

  .spaced {
    margin-top: 56px;
  }
  .musiker article {
    margin-top: 40px;
  }

  .musiker article h3 {
    margin-bottom: 0.4em;
  }

  .hint {
    color: var(--muted);
    font-size: 0.95em;
  }

  .mail-btn {
    min-height: 52px;
    font-size: 1.1em;
  }

  .mail-btn:focus-visible {
    outline: 4px solid var(--ink);
    outline-offset: 3px;
    box-shadow: 0 0 0 7px var(--gold);
    text-decoration: underline;
  }
</style>
