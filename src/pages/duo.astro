---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import didie from '../assets/img/didie-martin.jpg';
import trioBlau from '../assets/img/alpenexpress-trio-blau.webp';
---

<Base
  title="Duo & Trio – die Besetzungen für jedes Fest"
  description="Die Alpenexpress Partyband im Duo mit Gitarrist oder im Trio mit Band: die Top-Besetzungen für Feste, Hochzeiten, Zeltfeste und Firmenevents. Spitzenunterhaltung zu fairen Preisen."
>
  <PageHero eyebrow="Duo & Trio" title="Die Top-Kombination" lead="Die Alpenexpress Partyband gibt es im Duo mit Gitarrist oder im Trio mit Band für die ganz grossen Feste." />

  <section class="section">
    <div class="wrap grid grid--2">
      <Image src={didie} alt="Didie Martin von der Alpenexpress Partyband" class="photo" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 560px" />
      <div>
        <span class="eyebrow">Unser Motto</span>
        <h2>Spitzenunterhaltung zu fairen Preisen</h2>
        <p>
          Zu zweit wird's noch voller: Didie an Keyboard und Gesang, dazu ein Gitarrist mit echter Live-Gitarre. Gemeinsam bereichern wir deine Veranstaltung mit mitreissender Live-Musik – vom gefühlvollen Apéro bis zur ausgelassenen Party.
        </p>
        <p>Das Duo ist deine Garantie für:</p>
        <ul class="checklist">
          <li>Zufriedenheit bei jedem Event</li>
          <li>Professionelle Unterhaltung für Jung und Alt</li>
          <li>Echte Live-Gitarre</li>
          <li>Eigene Ton- und Lichttechnik</li>
        </ul>
        <p>Überlass nichts dem Zufall – wir beraten dich gerne und beantworten alle deine Fragen.</p>
        <div class="btn-row">
          <a class="btn" href={u('/kontakt/')}>Duo anfragen <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={u('/hochzeit/')}>Das Duo auf Hochzeiten</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Fotos</span>
      <h2>So sehen wir aus</h2>
      <div class="grid grid--2 align-start">
        <figure>
          <Image src={trioBlau} alt="Die Alpenexpress Partyband im Trio vor blauem Hintergrund: links ein Bassist mit Schiebermütze und blauem E-Bass, in der Mitte Didie mit Umhänge-Keyboard am Mikrofon, rechts ein Gitarrist mit heller Schirmmütze und E-Gitarre. Alle drei tragen schwarze T-Shirts und Lederhosen." class="photo" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 560px" />
          <figcaption>Die Alpenexpress Partyband im Trio</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap grid grid--2 align-start">
      <div>
        <span class="eyebrow">Alpenexpress Partyband im Trio</span>
        <h2>Noch mehr Power für grosse Feste</h2>
        <p>
          Für Zeltfeste, Vereinsfeste, Firmenevents und grosse Hochzeiten spielt die Alpenexpress Partyband auch im Trio mit Band – mit noch vollerem Live-Sound und Stimmung bis zum Schluss.
        </p>
        <div class="btn-row">
          <a class="btn" href={u('/kontakt/')}>Trio anfragen <Icon name="arrow" /></a>
        </div>
      </div>
      <div>
        <span class="eyebrow">Auf Anfrage</span>
        <h2>Didie als Alleinunterhalter</h2>
        <p>
          Für kleinere Feiern spielt Didie auf Anfrage auch solo mit Gesang und Keyboard. Frag einfach nach – wir sagen dir gerne, ob das für dein Fest passt.
        </p>
      </div>
    </div>
  </section>
</Base>
