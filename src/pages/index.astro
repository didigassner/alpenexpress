---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import AudioList from '../components/AudioList.astro';
import didie from '../assets/img/didie-martin.jpg';
import hotelSpecial from '../assets/img/hotel-special-2027.webp';
import { site } from '../data/site';
import { kommendeTermine, formatDatum } from '../data/termine';

const naechsterTermin = kommendeTermine()[0];

// Hotel-Special 2027: Formular auf der Seite, mailto bleibt als Alternative (Text so von Didi vorgegeben)
const hotelMessage = `Guten Tag,

hiermit fordere ich ausdrücklich das Informationsblatt zum Alpenexpress Hotel-Special 2027 per E-Mail an.

Freundliche Grüße`;

const hotelMail =
  'mailto:office@alpenexpress.at?subject=Anfrage%20%E2%80%93%20Alpenexpress%20Hotel-Special%202027&body=Guten%20Tag%2C%0A%0Ahiermit%20fordere%20ich%20ausdr%C3%BCcklich%20das%20Informationsblatt%20zum%20Alpenexpress%20Hotel-Special%202027%20per%20E-Mail%20an.%0A%0AHotelname%3A%0AAnsprechpartner%3A%0AGesch%C3%A4ftliche%20E-Mail-Adresse%3A%0A%0AFreundliche%20Gr%C3%BC%C3%9Fe';

const occasions = [
  {
    title: 'Hochzeiten und Geburtstage',
    text: 'Von der Trauung über den Apéro bis zur Party in den Morgenstunden – inklusive Wunschlied für den Brauttanz. Bei Geburtstagen und Jubiläen Musik für alle Generationen, die Gäste vom ersten Lied an auf die Tanzfläche holt.',
    link: { href: u('/hochzeit/'), label: 'Mehr zur Hochzeitsmusik' },
  },
  {
    title: 'Firmenfeiern, Vereinsfeste und Zeltfeste',
    text: 'Dezente Hintergrundmusik zum Essen, danach Stimmung – bei Firmen- und Weihnachtsfeiern genauso wie bei Oktoberfest, Grümpelturnier, Funkenfest oder Saisonabschluss. Partykracher und Mitsinglieder bis zum Schluss, für grosse Feste auch im Trio.',
    link: { href: u('/rueckblick/'), label: 'Zum Rückblick' },
  },
  {
    title: 'Hotels, Tanzveranstaltungen und Après-Ski',
    text: 'Tanzmusik, Stimmungslieder und aktuelle Hits für Hotelgäste, Tanzabende und Après-Ski – etwa bei der Weihnachtsfeier im Hotel Flexen in Zürs oder beim Tanz- und Stimmungsabend im Gasthaus Sternen in Kriessern.',
    link: { href: '#hotel-special', label: 'Zum Hotel-Special 2027' },
  },
];

const staerken = [
  { title: 'Duo oder Trio', text: 'Flexible Besetzung: im Duo mit Gitarrist oder im Trio mit Band.' },
  { title: 'Vielseitiges Repertoire', text: 'Hunderte Lieder in mehreren Sprachen – von Schlager und Volksmusik bis Rock und aktuellen Charts.' },
  { title: 'Bis zu 6 Stunden Musik', text: 'Bis zu sechs Stunden Live-Musik, nahezu durchgehend.' },
  { title: 'Bis 500 Gäste', text: 'Für Feste und Veranstaltungen mit bis zu 500 Gästen.' },
  { title: 'Wiederkehrende Buchungen', text: 'Veranstalter buchen immer wieder – beim Firmen-Oktoberfest in Zürich schon zum siebten Mal in Folge.' },
];

const faq = [
  {
    q: 'Wo spielt die Alpenexpress Partyband?',
    a: `Vor allem in Vorarlberg, der ganzen Schweiz mit Ostschweiz und Graubünden, in Liechtenstein und in Süddeutschland mit Allgäu und Bodenseeraum – auf Anfrage aber auch weiter weg. Zu Hause bin ich in ${site.city}, Vorarlberg.`,
  },
  {
    q: 'Duo oder Trio – was passt zu meinem Fest?',
    a: 'Das Duo mit Gitarrist passt zu den meisten Feiern und Hochzeiten. Für grosse Feste, Zeltfeste und Firmenevents gibt es das Trio mit Band und noch vollerem Sound. Als Alleinunterhalter spiele ich nur auf Anfrage. Gerne berate ich dich persönlich.',
  },
  {
    q: 'Kannst du auch mein Wunschlied spielen?',
    a: 'Sehr gerne! Ist ein Titel noch nicht im Repertoire, studiere ich ihn für dich ein – sag mir bitte etwa vier Wochen vor dem Termin Bescheid.',
  },
  {
    q: 'Wie schnell sollte ich buchen?',
    a: 'Gerade an Wochenenden im Sommer und in der Hochzeitssaison sind Termine schnell vergeben. Bestätige deinen Termin am besten innerhalb von fünf Tagen nach meinem Angebot – danach kann er bereits vergeben sein.',
  },
  {
    q: 'Was kostet ein Auftritt?',
    a: 'Das hängt von Dauer, Ort und Besetzung ab. Schick mir einfach eine kurze Anfrage, du bekommst ein kostenloses und unverbindliches Angebot – faire Preise sind mir wichtig.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const included = [
  'Hintergrundmusik zum Apéro und Essen',
  'Professionelle Ton- und Lichtanlage',
  'Technik für Präsentationen und Showeinlagen',
  'Angenehme Lautstärke – auch für ältere Gäste',
  'Animation und Mitmachspiele auf Wunsch',
  'Tipps für Locations und Catering (A & CH)',
];

const genres = ['Partyhits', 'Aktuelle Charts', 'Austropop', 'Schweizer Mundart', 'Schlager', 'Volksmusik', 'Oberkrainer', '70er – 90er', "Rock 'n' Roll", 'Rock & Pop', 'Country', 'Line Dance', 'Evergreens', 'Tanzmusik'];
---

<Base
  title="Alpenexpress Partyband – Live-Band aus Vorarlberg im Duo & Trio"
  description="Partyband im Duo oder Trio für Hochzeiten, Geburtstage, Firmenfeiern, Zeltfeste, Hotels und Tanzabende in Vorarlberg, der Ostschweiz, Graubünden, Liechtenstein und Süddeutschland."
  jsonLd={[faqJsonLd]}
>
  <section class="hotel-special" id="hotel-special" aria-labelledby="hotel-special-titel">
    <div class="wrap">
    <div class="hotel-special__inner">
      <div class="hotel-special__bild">
        <Image
          src={hotelSpecial}
          alt="Alpenexpress Hotel-Special 2027: Live-Musik, die Ihre Gäste begeistert! Exklusiver Hotelvorteil für Hotels – Informationsblatt auf Anfrage."
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 680px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hotel-special__text">
        <span class="eyebrow">Für Hotels</span>
        <h2 id="hotel-special-titel">Alpenexpress Hotel-Special 2027</h2>
        <p>Live-Musik, die Ihre Gäste begeistert – mit einem exklusiven Vorteil für Hotels.</p>
        <p class="hotel-special__hinweis">
          Das Informationsblatt senden wir Ihnen nach Ihrer Anfrage persönlich per E-Mail zu. Die Anfrage gilt nur für dieses Angebot – keine weitere Werbung.
        </p>
      </div>
    </div>

        <p class="hotel-special__error" id="hotel-special-fehler" role="alert">
          Das hat leider nicht geklappt. Bitte prüfen Sie Ihre Angaben oder schreiben Sie uns direkt an <a href="mailto:office@alpenexpress.at">office@alpenexpress.at</a>.
        </p>

        <form id="hotel-anfrage" class="hotel-special__form" action={u('/anfrage.php')} method="post" accept-charset="UTF-8">
          <input type="hidden" name="typ" value="hotel-special" />
          <div class="hotel-special__row">
            <label for="hotel-name">
              Ihr Name *
              <input id="hotel-name" name="name" required maxlength="100" autocomplete="name" />
            </label>
            <label for="hotel-betrieb">
              Hotel / Betrieb *
              <input id="hotel-betrieb" name="hotel" required maxlength="200" autocomplete="organization" />
            </label>
          </div>
          <div class="hotel-special__row">
            <label for="hotel-email">
              Ihre E-Mail *
              <input id="hotel-email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </label>
            <label for="hotel-telefon">
              Telefon (optional)
              <input id="hotel-telefon" name="telefon" type="tel" maxlength="50" autocomplete="tel" />
            </label>
          </div>
          <label for="hotel-nachricht">
            Ihre Nachricht *
            <textarea id="hotel-nachricht" name="nachricht" rows="7" required maxlength="4000">{hotelMessage}</textarea>
          </label>
          <div class="hp" aria-hidden="true">
            <label>
              Bitte nicht ausfüllen
              <input name="homepage" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <input type="hidden" name="dauer" value="" />
          <label class="hotel-special__consent" for="hotel-einwilligung">
            <input id="hotel-einwilligung" name="einwilligung" type="checkbox" value="1" required />
            <span>
              Ich willige ein, dass meine Angaben zur Bearbeitung dieser Anfrage per E-Mail an die Alpenexpress Partyband übermittelt werden. Die Anfrage gilt nur für dieses Angebot – keine weitere Werbung. Mehr dazu in der <a href={u('/datenschutz/')}>Datenschutzerklärung</a>.
            </span>
          </label>
          <button class="btn hotel-special__btn" type="submit">
            <Icon name="mail" /> Fordern Sie jetzt Ihren exklusiven Hotelvorteil an!
          </button>
        </form>
        <p class="hotel-special__hinweis">
          Lieber direkt per E-Mail? Nutzen Sie den <a href={hotelMail}>vorbereiteten E-Mail-Entwurf</a> oder schreiben Sie an <a href="mailto:office@alpenexpress.at">office@alpenexpress.at</a>.
        </p>
    </div>
  </section>

  <section class="hero">
    <Image src={didie} alt="Didie Martin von der Alpenexpress Partyband" class="hero__img" widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="wrap hero__content">
      <span class="eyebrow">Partyband aus Vorarlberg – im Duo oder Trio</span>
      <h1>Alpenexpress Partyband – Ihre Live-Band für Österreich, die Schweiz, Liechtenstein und Deutschland.</h1>
      <p class="hero__sub">Musik, die Generationen verbindet!</p>
      <p class="lead">
        Live-Musik im Duo oder Trio für Hochzeiten, Geburtstage, Firmenfeiern, Vereins- und Zeltfeste, Hotels, Tanzveranstaltungen und Après-Ski – in Vorarlberg, der Ostschweiz, Graubünden, Liechtenstein, Süddeutschland, im Allgäu und im Bodenseeraum.
      </p>
      <div class="btn-row">
        <a class="btn" href={u('/kontakt/')}>Kostenloses Angebot anfragen <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={u('/mediathek/')}>Hörproben anhören</a>
      </div>
    </div>
  </section>

  <section class="staerken" aria-labelledby="staerken-titel">
    <div class="wrap">
      <h2 id="staerken-titel" class="visually-hidden">Das zeichnet die Alpenexpress Partyband aus</h2>
      <ul class="staerken__liste">
        {
          staerken.map((st) => (
            <li>
              <strong>{st.title}</strong>
              <span>{st.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    naechsterTermin && (
      <section class="section section--white termin" id="termine">
        <div class="wrap grid grid--2">
          <div>
            <span class="eyebrow">Nächster Termin</span>
            <h2>
              {naechsterTermin.title}
              {naechsterTermin.besetzung && <span class="termin__besetzung"> {naechsterTermin.besetzung}</span>}
            </h2>
            <dl class="termin__facts">
              <dt>Datum</dt>
              <dd>{formatDatum(naechsterTermin.date)}</dd>
              <dt>Zeit</dt>
              <dd>{naechsterTermin.time}</dd>
              <dt>Ort</dt>
              <dd>
                {naechsterTermin.location}, {naechsterTermin.place}
              </dd>
            </dl>
            {naechsterTermin.text && <p class="lead">{naechsterTermin.text}</p>}
          </div>
          {naechsterTermin.flyer && (
            <a href={naechsterTermin.flyer.src} class="termin__flyer" target="_blank" rel="noopener">
              <Image
                src={naechsterTermin.flyer}
                alt={naechsterTermin.flyerAlt ?? naechsterTermin.title}
                class="photo"
                widths={[400, 700, 1000]}
                sizes="(max-width: 760px) 100vw, 480px"
              />
            </a>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <span class="eyebrow">Herzlich willkommen</span>
        <h2>Hey, ich bin Didie!</h2>
        <p>
          Didie Martin von der Alpenexpress Partyband. Seit vielen Jahren stehe ich mit Gesang und Keyboard auf der Bühne – mit einem Ziel: dass dein Fest ein voller Erfolg wird. Ob im Duo mit Gitarrist oder im Trio mit Band, ich lebe leidenschaftlich für die Musik, weil sie
        </p>
        <ul class="checklist">
          <li>glücklich macht,</li>
          <li>Spass macht,</li>
          <li>Freude bringt</li>
          <li>und vor allem Menschen verbindet.</li>
        </ul>
        <p>
          Bekannt aus Funk und Fernsehen – unter anderem aus der Rudi Carrell Show – und gebucht von Brautpaaren, Vereinen und Unternehmen weit über Vorarlberg hinaus.
        </p>
        <a href={u('/didie/')}>Mehr über mich <Icon name="arrow" class="inline-icon" /></a>
      </div>
      <Image src={didie} alt="Didie Martin von der Alpenexpress Partyband" class="photo" widths={[480, 800, 1075]} sizes="(max-width: 760px) 100vw, 560px" />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <span class="eyebrow">Für jeden Anlass</span>
      <h2>Anlässe für die Alpenexpress Partyband</h2>
      <div class="grid grid--3 occasions">
        {
          occasions.map((o) => (
            <div class="card occasion">
              <h3>{o.title}</h3>
              <p>{o.text}</p>
              <p class="occasion__link">
                <a href={o.link.href}>
                  {o.link.label} <Icon name="arrow" class="inline-icon" />
                </a>
              </p>
            </div>
          ))
        }
      </div>
      <div class="btn-row occasions-cta">
        <a class="btn" href={u('/kontakt/')}>Unverbindlich anfragen <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap grid grid--2 align-start">
      <div>
        <span class="eyebrow">Ohne Mehrkosten</span>
        <h2>Das ist bei mir inklusive</h2>
        <p class="lead">
          Du sollst dein Fest geniessen können, statt dich um Technik zu kümmern. Deshalb gehört bei mir mehr dazu als nur die Musik.
        </p>
        <ul class="checklist">
          {included.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div>
        <h3>Riesige Liederauswahl – in mehreren Sprachen</h3>
        <p>Von AC/DC bis ins Zillertal: Das Programm passt zu jedem Geschmack und jedem Alter.</p>
        <ul class="tags">
          {genres.map((g) => <li>{g}</li>)}
        </ul>
        <p class="more"><a href={u('/repertoire/')}>Zum Repertoire <Icon name="arrow" class="inline-icon" /></a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--2 align-start">
      <div>
        <span class="eyebrow">Reinhören</span>
        <h2>So klingt die Alpenexpress Partyband</h2>
        <p class="lead">Zwei kurze Hörproben aus dem Programm – viele weitere findest du in der Mediathek.</p>
        <a class="btn" href={u('/mediathek/')}>Alle Hörproben & Videos</a>
      </div>
      <AudioList
        tracks={[
          { title: "What You're Proposing", artist: 'Status Quo', file: 'what-youre-proposing.mp3' },
          { title: 'Dem Land Tirol die Treue', file: 'dem-land-tirol-die-treue.mp3' },
        ]}
      />
    </div>
  </section>

  <Testimonials />

  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">Gut zu wissen</span>
      <h2>Häufige Fragen</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const hotelForm = document.querySelector<HTMLFormElement>('#hotel-anfrage');
  hotelForm?.addEventListener('submit', () => {
    const elapsed = hotelForm.querySelector<HTMLInputElement>('input[name="dauer"]');
    if (elapsed) elapsed.value = String(Math.round(performance.now()));
  });
</script>

<style>
  .hotel-special {
    background: var(--ink);
    color: #fff;
    padding-block: clamp(16px, 3vw, 40px);
  }

  .hotel-special__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
    margin-bottom: 8px;
  }

  .hotel-special__bild {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .hotel-special__bild img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hotel-special__text h2 {
    margin-bottom: 0.4em;
  }

  .hotel-special .eyebrow {
    color: var(--gold);
  }

  .hotel-special__text p {
    color: #e9e6df;
  }

  .hotel-special__btn {
    width: 100%;
    max-width: 40rem;
    min-height: 64px;
    margin: 8px 0 0;
    justify-self: start;
    padding: 0.9em 1.2em;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 750;
    line-height: 1.25;
    text-align: center;
    background: var(--gold);
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
  }

  .hotel-special__btn:hover,
  .hotel-special__btn:focus-visible {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .hotel-special__hinweis {
    font-size: 0.95rem;
    margin-bottom: 0.5em;
  }

  .hotel-special__hinweis a {
    color: var(--gold);
    font-weight: 650;
  }

  .hotel-special__error {
    display: none;
    margin: 0 0 16px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 2px solid var(--gold);
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font-weight: 600;
  }

  .hotel-special__error:target {
    display: block;
  }

  .hotel-special__error a {
    color: var(--gold);
    font-weight: 700;
  }

  .hotel-special__form {
    display: grid;
    gap: 16px;
    margin: 20px 0 16px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--paper);
    color: var(--text);
    border-radius: var(--radius);
  }

  .hotel-special__row {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .hotel-special__form label {
    display: grid;
    gap: 6px;
    font-weight: 650;
    font-size: 1.05rem;
  }

  .hotel-special__form input:not([type='checkbox']),
  .hotel-special__form textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text);
    background: var(--card);
    border: 2px solid var(--line);
    border-radius: 10px;
  }

  .hotel-special__form textarea {
    min-height: 12em;
    resize: vertical;
  }

  .hotel-special__form input:focus-visible,
  .hotel-special__form textarea:focus-visible,
  .hotel-special__consent input:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
    border-color: var(--ink);
  }

  .hotel-special__consent {
    display: flex !important;
    align-items: flex-start;
    gap: 12px;
    font-weight: 500 !important;
    font-size: 1rem !important;
    line-height: 1.45;
  }

  .hotel-special__consent input {
    width: 28px;
    height: 28px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--accent);
  }

  .hotel-special__form a {
    color: var(--accent);
    font-weight: 650;
  }

  .hotel-special__form .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .hotel-special__inner {
      grid-template-columns: 1fr;
    }
  }
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(88vh, 820px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: var(--ink);
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
    z-index: -2;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(14 15 18 / 0.95) 0%, rgb(14 15 18 / 0.6) 45%, rgb(14 15 18 / 0.1) 100%),
      linear-gradient(to right, rgb(14 15 18 / 0.6), transparent 70%);
  }

  .hero__content {
    padding-block: 120px clamp(48px, 8vw, 96px);
  }

  .hero h1 {
    max-width: 24ch;
    font-size: clamp(2.2rem, 1.4rem + 3.6vw, 4.4rem);
    margin-bottom: 0.25em;
  }

  .hero__sub {
    font-family: var(--display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--gold);
    margin-bottom: 0.6em;
  }

  .staerken {
    background: var(--accent);
    color: #fff;
    padding-block: clamp(20px, 3vw, 32px);
  }

  .staerken__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 16px 24px;
  }

  .staerken__liste li {
    display: grid;
    gap: 4px;
  }

  .staerken__liste strong {
    font-size: 1.1rem;
  }

  .staerken__liste span {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .occasion__link {
    margin-top: 12px !important;
  }

  .occasion__link a {
    font-weight: 650;
  }

  .hero .eyebrow {
    color: var(--gold);
  }

  .hero .lead {
    color: #ddd8ce;
    margin-bottom: 28px;
  }

  .termin .grid--2 {
    align-items: center;
