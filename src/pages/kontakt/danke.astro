---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="Danke für deine Anfrage" description="Deine Anfrage ist angekommen." noindex noContactBand>
  <PageHero eyebrow="Anfrage gesendet" title="Danke – wir melden uns bei dir!" lead="Deine Anfrage ist bei uns angekommen. Du bekommst so bald wie möglich eine Antwort.">
    <div class="btn-row" style="margin-top: 24px">
      <a class="btn" href={u('/')}>Zur Startseite</a>
      <a class="btn btn--ghost" href={u('/mediathek/')}>Hörproben anhören</a>
    </div>
  </PageHero>
</Base>
