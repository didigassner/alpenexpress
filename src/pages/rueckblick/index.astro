---
import { u } from '../../lib/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import logoIcon from '../../assets/img/logo-icon.png';

const posts = (await getCollection('rueckblick')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('de-AT', { month: 'long', year: 'numeric' });
---

<Base
  title="Rückblick – Auftritte & Feste"
  description="Rückblick auf Auftritte der Alpenexpress Partyband: Hochzeiten, Oktoberfeste, Vereinsfeste, Firmen- und Weihnachtsfeiern in Vorarlberg und der Schweiz."
>
  <PageHero eyebrow="Rückblick" title="Feste, die in Erinnerung bleiben" lead="Eine Auswahl vergangener Auftritte – von der Traumhochzeit bis zum vollen Festzelt." />

  <section class="section">
    <div class="wrap">
      <ul class="posts">
        {
          posts.map((p) => (
            <li>
              <a class="card post" href={u(`/rueckblick/${p.id}/`)}>
                <div class="post__img">
                  {p.data.image ? (
                    <Image src={p.data.image} alt="" widths={[360, 560]} sizes="(max-width: 700px) 100vw, 360px" />
                  ) : (
                    <Image src={logoIcon} alt="" width={96} class="post__placeholder" />
                  )}
                </div>
                <div class="post__body">
                  <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                  <h2>{p.data.title}</h2>
                  <p>{p.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }

  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s;
  }

  .post:hover {
    color: inherit;
    transform: translateY(-3px);
  }

  .post__img {
    aspect-ratio: 16 / 10;
    background: var(--ink);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .post__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__img img.post__placeholder {
    width: 96px;
    height: 96px;
    object-fit: contain;
    filter: invert(1);
    opacity: 0.35;
  }

  .post__body {
    padding: 20px 24px 24px;
  }

  .post time {
    color: var(--accent);
    font-weight: 650;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post h2 {
    font-size: 1.9rem;
    margin: 6px 0 8px;
  }

  .post p {
    color: var(--muted);
    margin: 0;
  }
</style>
